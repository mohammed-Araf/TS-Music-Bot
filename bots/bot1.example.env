# Bot Nickname in TeamSpeak & Spotify Connect device name
TS_NICK=MusicBot1
SPOTIFY_DEVICE_NAME=MusicBot1

# (Optional) Admin Server Group IDs (e.g. 6 for Server Admin)
ADMIN_SERVER_GROUPS=6

# (Optional) Server Group IDs allowed to play music (e.g. 50). Leave blank to allow everyone.
ALLOWED_SERVER_GROUPS=50

# (Optional) Specific Admin User UIDs
ADMIN_UIDS=
