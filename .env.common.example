TS_HOST=your.teamspeak.server
TS_PORT=9987
TS_CHANNEL=Music
TS_SERVER_PASSWORD=
TS_CHANNEL_PASSWORD=

CMD_PREFIX=!
CMD_COOLDOWN=1.5
MAX_VOLUME=80
INITIAL_VOLUME=40

# Spotify developer app credentials (used for search only)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
