# ==============================================================================
# TS-Music-Bot Configuration
# ==============================================================================

# TeamSpeak 3 Server (Required)
TS_HOST=your.teamspeak.server
TS_PORT=9987
TS_CHANNEL=Music
TS_SERVER_PASSWORD=
TS_CHANNEL_PASSWORD=

# Channel drag behaviour (optional)
# FOLLOW_DRAG=true        # allow users to drag the bot; it returns home when nobody there is listening
# RETURN_HOME_DELAY=0     # seconds to wait in an abandoned channel before going home (0 = instantly)
# IGNORE_DEAFENED=true    # deafened users (speakers muted) don't count as listeners

# Player panel (optional)
# PLAYER_DESCRIPTION=true  # write progress/volume/requester into the bot's description (needs b_client_modify_description)
# DESC_INTERVAL=5          # min seconds between description rewrites

# Bot Settings
CMD_PREFIX=!
CMD_COOLDOWN=1.5
MAX_VOLUME=80
INITIAL_VOLUME=40

# (Optional) Custom Spotify Search API keys.
# Leave blank to use built-in keys, or configure directly from chat via !spotifykeys
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
