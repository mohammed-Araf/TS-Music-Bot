# ==============================================================================
# TS-Music-Bot Configuration
# ==============================================================================

# TeamSpeak 3 Server (Required)
TS_HOST=your.teamspeak.server
TS_PORT=9987
TS_CHANNEL=Music
TS_SERVER_PASSWORD=
TS_CHANNEL_PASSWORD=

# Bot Settings
CMD_PREFIX=!
CMD_COOLDOWN=1.5
MAX_VOLUME=80
INITIAL_VOLUME=40

# (Optional) Custom Spotify Search API keys.
# Leave blank to use built-in keys, or configure directly from chat via !spotifykeys
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
